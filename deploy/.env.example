# Copy to deploy/.env and fill in before running docker compose.

# Database
POSTGRES_DB=tanso
POSTGRES_USER=tanso
# Set a real password — "changeme" is a non-functional placeholder
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
# Required. Generate one: openssl rand -base64 48
JWT_SECRET=
# Required. Encrypts stored integration credentials (Stripe keys, vendor admin keys) at rest.
# Generate one: openssl rand -base64 48. Losing it means re-entering every connected key.
APP_SECRETS_KEY=
API_PORT=8080

# Stripe (optional — leave empty to run without Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP server for AI agents (optional, off by default).
# Set both to true to expose the /mcp endpoint.
# APP_MCP_ENABLED=true
# SPRING_AI_MCP_SERVER_ENABLED=true

# Anonymous daily instance telemetry (on by default; payload documented in README).
# Uncomment to opt out.
# TANSO_TELEMETRY_ENABLED=false

# Internal AI spend (the "build side": Spend section in the console, /api/v1/spend/**).
# On by default. Set to false for a serve-side-only install.
# APP_MODULES_BUILD_ENABLED=false
