# Copy to deploy/.env and fill in before running docker compose.

# Database
POSTGRES_DB=tanso
POSTGRES_USER=tanso
# Set a real password — "changeme" is a non-functional placeholder
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
# Required. Generate one: openssl rand -base64 48
JWT_SECRET=
# Required. Encrypts stored integration credentials (Stripe keys, vendor admin keys) at rest.
# Generate one: openssl rand -base64 48. Losing it means re-entering every connected key.
APP_SECRETS_KEY=
# Optional: alert emails and the weekly digest go out through Resend. Leave empty to skip email.
APP_RESEND_API_KEY=
APP_SPEND_ALERT_FROM="Tanso <alerts@your-domain.com>"
API_PORT=8080

# Stripe (optional — leave empty to run without Stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# MCP server for AI agents (optional, off by default).
# Set both to true to expose the /mcp endpoint.
# APP_MCP_ENABLED=true
# SPRING_AI_MCP_SERVER_ENABLED=true

# Anonymous daily instance telemetry (on by default; payload documented in README).
# Uncomment to opt out.
# TANSO_TELEMETRY_ENABLED=false

# Each half of the engine can run on its own. Both are on by default.
# Monetization: plans, customers, credits, invoices, the client API, Stripe.
# Set to false for an internal-spend-only install.
# APP_MODULES_MONETIZATION_ENABLED=false
# Internal spend: the Spend section in the console, /api/v1/spend/**.
# Set to false for a monetization-only install.
# APP_MODULES_BUILD_ENABLED=false
# Where the build side pulls usage and cost from. Only change these to point at a gateway or proxy.
# APP_SPEND_ANTHROPIC_BASE_URL=https://api.anthropic.com
# APP_SPEND_OPENAI_BASE_URL=https://api.openai.com
# APP_SPEND_GITHUB_BASE_URL=https://api.github.com
# APP_SPEND_LINEAR_BASE_URL=https://api.linear.app/graphql   # a full endpoint, unlike the others
# APP_SPEND_CURSOR_BASE_URL=https://api.cursor.com
